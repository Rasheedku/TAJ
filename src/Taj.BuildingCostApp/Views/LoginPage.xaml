<Page
    x:Class="Taj.BuildingCostApp.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Taj.BuildingCostApp.ViewModels"
    mc:Ignorable="d">

    <Page.DataContext>
        <vm:LoginViewModel />
    </Page.DataContext>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="40">
        <StackPanel Width="360" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <TextBlock Text="TAJ" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock x:Uid="LoginTitle" Text="Login" FontSize="18" HorizontalAlignment="Center" />
            <TextBox x:Uid="LoginUsername" Header="Username" Text="{Binding Username, Mode=TwoWay}" />
            <PasswordBox x:Name="PasswordBox" x:Uid="LoginPassword" Header="Password" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Tomato" TextWrapping="Wrap" />
            <Button x:Uid="LoginButton" Content="Login" Click="OnLoginClick" />
        </StackPanel>
    </Grid>
</Page>
