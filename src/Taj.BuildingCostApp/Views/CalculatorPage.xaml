<Page
    x:Class="Taj.BuildingCostApp.Views.CalculatorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Taj.BuildingCostApp.ViewModels"
    xmlns:models="using:Taj.BuildingCostApp.Models"
    mc:Ignorable="d">

    <Page.DataContext>
        <vm:CalculatorViewModel />
    </Page.DataContext>

    <ScrollViewer>
        <StackPanel Spacing="20" Padding="24">
            <TextBlock Text="Project Cost Calculator" FontSize="24" FontWeight="SemiBold" />

            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="1. Building Dimensions" FontSize="18" FontWeight="SemiBold" />
                    <ComboBox Header="Building Shape" ItemsSource="{Binding BuildingShapeOptions}" SelectedItem="{Binding SelectedShape, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{Binding IsRectangle, Converter={StaticResource BoolToVisibility}}">
                        <NumberBox Header="Length (m)" Value="{Binding Length, Mode=TwoWay}" Width="180" />
                        <NumberBox Header="Width (m)" Value="{Binding Width, Mode=TwoWay}" Width="180" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{Binding IsLShape, Converter={StaticResource BoolToVisibility}}">
                        <NumberBox Header="Overall Length (m)" Value="{Binding OverallLength, Mode=TwoWay}" Width="180" />
                        <NumberBox Header="Overall Width (m)" Value="{Binding OverallWidth, Mode=TwoWay}" Width="180" />
                        <NumberBox Header="Cutout Length (m)" Value="{Binding CutoutLength, Mode=TwoWay}" Width="180" />
                        <NumberBox Header="Cutout Width (m)" Value="{Binding CutoutWidth, Mode=TwoWay}" Width="180" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{Binding IsUShape, Converter={StaticResource BoolToVisibility}}">
                        <NumberBox Header="Overall Length (m)" Value="{Binding OverallLength, Mode=TwoWay}" Width="180" />
                        <NumberBox Header="Overall Width (m)" Value="{Binding OverallWidth, Mode=TwoWay}" Width="180" />
                        <NumberBox Header="Courtyard Width (m)" Value="{Binding CourtyardWidth, Mode=TwoWay}" Width="180" />
                        <NumberBox Header="Courtyard Depth (m)" Value="{Binding CourtyardDepth, Mode=TwoWay}" Width="180" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <NumberBox Header="Internal Height (m)" Value="{Binding InternalHeight, Mode=TwoWay}" Width="180" />
                        <NumberBox Header="External Height (m)" Value="{Binding ExternalHeight, Mode=TwoWay}" Width="180" />
                        <NumberBox Header="Area (m²)" Value="{Binding BuildingArea}" Width="180" IsReadOnly="True" />
                    </StackPanel>
                    <Canvas x:Name="PlanCanvas" Height="220" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="2. Foundations" FontSize="18" FontWeight="SemiBold" />
                    <ComboBox Header="Type" ItemsSource="{Binding FoundationOptions}" SelectedItem="{Binding FoundationType, Mode=TwoWay}" />
                    <TextBlock Text="{Binding FoundationCost, StringFormat='Cost: {0:N2} AED'}" />
                </StackPanel>
            </Border>

            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="3. Glass" FontSize="18" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <NumberBox Header="Linear meters" Value="{Binding GlassLinearMeters, Mode=TwoWay}" Width="180" />
                        <NumberBox Header="Height (m)" Value="{Binding GlassHeight, Mode=TwoWay}" Width="180" />
                    </StackPanel>
                    <ComboBox Header="Type" ItemsSource="{Binding GlassOptions}" SelectedItem="{Binding GlassType, Mode=TwoWay}" />
                    <TextBlock Text="{Binding GlassCost, StringFormat='Cost: {0:N2} AED'}" />
                </StackPanel>
            </Border>

            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="4. Skids" FontSize="18" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <NumberBox Header="Number of skids" Value="{Binding NumberOfSkids, Mode=TwoWay}" Width="180" />
                    </StackPanel>
                    <ComboBox Header="Finish" ItemsSource="{Binding SkidOptions}" SelectedItem="{Binding SkidFinish, Mode=TwoWay}" />
                    <TextBlock Text="{Binding SkidCost, StringFormat='Cost: {0:N2} AED'}" />
                </StackPanel>
            </Border>

            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="5. Walls" FontSize="18" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <NumberBox Header="Partitions length (m)" Value="{Binding TotalPartitionsLength, Mode=TwoWay}" Width="180" />
                        <NumberBox Header="Wet area walls (m)" Value="{Binding WetAreaWallsLength, Mode=TwoWay}" Width="180" />
                        <NumberBox Header="Exterior walls (m)" Value="{Binding ExteriorWallsLength, Mode=TwoWay}" Width="180" />
                    </StackPanel>
                    <ComboBox Header="Exterior Finish" ItemsSource="{Binding ExteriorFinishOptions}" SelectedItem="{Binding ExteriorFinish, Mode=TwoWay}" />
                    <TextBlock Text="{Binding ExteriorWallCost, StringFormat='Exterior Cost: {0:N2} AED'}" />
                    <TextBlock Text="{Binding WetWallCost, StringFormat='Wet Area Cost: {0:N2} AED'}" />
                    <TextBlock Text="{Binding PartitionWallCost, StringFormat='Partitions Cost: {0:N2} AED'}" />
                </StackPanel>
            </Border>

            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="6. Roof" FontSize="18" FontWeight="SemiBold" />
                    <ToggleSwitch Header="Parapet" IsOn="{Binding HasParapet, Mode=TwoWay}" />
                    <NumberBox Header="Parapet Area (m²)" Value="{Binding ParapetAreaM2, Mode=TwoWay}" Width="180" IsEnabled="{Binding HasParapet}" />
                    <TextBlock Text="{Binding RoofCost, StringFormat='Roof Cost: {0:N2} AED'}" />
                    <TextBlock Text="{Binding ParapetCost, StringFormat='Parapet Cost: {0:N2} AED'}" />
                </StackPanel>
            </Border>

            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="7. False Ceiling" FontSize="18" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <NumberBox Header="60x60 Area (m²)" Value="{Binding Ceiling6060AreaM2, Mode=TwoWay}" Width="180" />
                        <NumberBox Header="Gypsum + Lighting Area (m²)" Value="{Binding GypsumWithLightingAreaM2, Mode=TwoWay}" Width="220" />
                    </StackPanel>
                    <TextBlock Text="{Binding Ceiling6060Cost, StringFormat='60x60 Cost: {0:N2} AED'}" />
                    <TextBlock Text="{Binding GypsumCost, StringFormat='Gypsum Cost: {0:N2} AED'}" />
                </StackPanel>
            </Border>

            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="8. External Flooring" FontSize="18" FontWeight="SemiBold" />
                    <ToggleSwitch Header="Enable External Flooring" IsOn="{Binding EnableExternalFlooring, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="12" IsEnabled="{Binding EnableExternalFlooring}">
                        <NumberBox Header="Area (m²)" Value="{Binding ExternalFloorAreaM2, Mode=TwoWay}" Width="180" />
                        <ComboBox Header="Finish" ItemsSource="{Binding ExternalFloorOptions}" SelectedItem="{Binding ExternalFloorFinish, Mode=TwoWay}" Width="180" />
                    </StackPanel>
                    <TextBlock Text="{Binding ExternalFloorCost, StringFormat='Cost: {0:N2} AED'}" />
                </StackPanel>
            </Border>

            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="9. Electrical Works" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ElectricalCost, StringFormat='Cost: {0:N2} AED'}" />
                </StackPanel>
            </Border>

            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="10. Plumbing & Sanitary" FontSize="18" FontWeight="SemiBold" />
                    <ToggleSwitch Header="Has Bathrooms" IsOn="{Binding HasBathrooms, Mode=TwoWay}" />
                    <NumberBox Header="Total Cost" Value="{Binding BathroomTotalCost, Mode=TwoWay}" Width="180" IsEnabled="{Binding HasBathrooms}" />
                    <TextBlock Text="{Binding BathroomCost, StringFormat='Cost: {0:N2} AED'}" />
                </StackPanel>
            </Border>

            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="11. Internal Doors" FontSize="18" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding DoorItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DoorQuantityItem">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{x:Bind DoorType.Name}" Width="140" />
                                    <NumberBox Value="{x:Bind Quantity, Mode=TwoWay}" Width="120" />
                                    <TextBlock Text="{x:Bind Total, Mode=OneWay, StringFormat='Total: {0:N2} AED'}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding DoorCost, StringFormat='Cost: {0:N2} AED'}" />
                </StackPanel>
            </Border>

            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="12. Pantry / Kitchen" FontSize="18" FontWeight="SemiBold" />
                    <ToggleSwitch Header="Include Pantry" IsOn="{Binding HasPantry, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="12" IsEnabled="{Binding HasPantry}">
                        <NumberBox Header="Cabinet Length (lm)" Value="{Binding CabinetLengthLm, Mode=TwoWay}" Width="180" />
                        <ComboBox Header="Finish" ItemsSource="{Binding PantryFinishOptions}" SelectedItem="{Binding PantryFinish, Mode=TwoWay}" Width="180" />
                    </StackPanel>
                    <TextBlock Text="{Binding PantryCost, StringFormat='Cost: {0:N2} AED'}" />
                </StackPanel>
            </Border>

            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="13. Delivery & Offloading" FontSize="18" FontWeight="SemiBold" />
                    <ComboBox Header="Emirate" ItemsSource="{Binding EmirateOptions}" SelectedItem="{Binding SelectedEmirate, Mode=TwoWay}" />
                    <NumberBox Header="Crane/Offloading Cost" Value="{Binding CraneOffloadingCost, Mode=TwoWay}" Width="180" />
                    <TextBlock Text="{Binding DeliveryCost, StringFormat='Delivery Cost: {0:N2} AED'}" />
                </StackPanel>
            </Border>

            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Additional Costs" FontSize="18" FontWeight="SemiBold" />
                    <NumberBox Header="Extra Costs" Value="{Binding ExtraCosts, Mode=TwoWay}" Width="180" />
                </StackPanel>
            </Border>

            <Border x:Name="SummaryPanel" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Summary" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding FoundationCost, StringFormat='Foundations: {0:N2} AED'}" />
                    <TextBlock Text="{Binding GlassCost, StringFormat='Glass: {0:N2} AED'}" />
                    <TextBlock Text="{Binding SkidCost, StringFormat='Skids: {0:N2} AED'}" />
                    <TextBlock Text="{Binding ExteriorWallCost, StringFormat='Exterior Walls: {0:N2} AED'}" />
                    <TextBlock Text="{Binding WetWallCost, StringFormat='Wet Walls: {0:N2} AED'}" />
                    <TextBlock Text="{Binding PartitionWallCost, StringFormat='Partitions: {0:N2} AED'}" />
                    <TextBlock Text="{Binding RoofCost, StringFormat='Roof: {0:N2} AED'}" />
                    <TextBlock Text="{Binding ParapetCost, StringFormat='Parapet: {0:N2} AED'}" />
                    <TextBlock Text="{Binding Ceiling6060Cost, StringFormat='Ceiling 60x60: {0:N2} AED'}" />
                    <TextBlock Text="{Binding GypsumCost, StringFormat='Gypsum: {0:N2} AED'}" />
                    <TextBlock Text="{Binding ExternalFloorCost, StringFormat='External Flooring: {0:N2} AED'}" />
                    <TextBlock Text="{Binding ElectricalCost, StringFormat='Electrical: {0:N2} AED'}" />
                    <TextBlock Text="{Binding BathroomCost, StringFormat='Plumbing: {0:N2} AED'}" />
                    <TextBlock Text="{Binding DoorCost, StringFormat='Doors: {0:N2} AED'}" />
                    <TextBlock Text="{Binding PantryCost, StringFormat='Pantry: {0:N2} AED'}" />
                    <TextBlock Text="{Binding DeliveryCost, StringFormat='Delivery: {0:N2} AED'}" />
                    <TextBlock Text="{Binding ExtraCosts, StringFormat='Extra Costs: {0:N2} AED'}" />
                    <TextBlock Text="{Binding GrandTotal, StringFormat='Grand Total: {0:N2} AED'}" FontSize="18" FontWeight="Bold" />
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
                        <Button Content="Export PDF" Command="{Binding ExportPdfCommand}" />
                        <Button Content="Export PNG" Command="{Binding ExportPngCommand}" CommandParameter="{Binding ElementName=SummaryPanel}" />
                        <Button Content="Share via WhatsApp" Command="{Binding ShareWhatsAppCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
