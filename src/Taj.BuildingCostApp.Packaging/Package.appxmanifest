<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  IgnorableNamespaces="uap mp uap3">

  <Identity Name="Taj.BuildingCostApp" Publisher="CN=TAJ" Version="1.0.0.0" />
  <mp:PhoneIdentity PhoneProductId="f76f2665-33c2-4c01-9c58-78c8b9967a40" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties>
    <DisplayName>TAJ Building Cost App</DisplayName>
    <PublisherDisplayName>TAJ</PublisherDisplayName>
    <Logo>Assets\StoreLogo.svg</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
    <Resource Language="ar-sa" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="Taj.BuildingCostApp.App">
      <uap:VisualElements
        DisplayName="TAJ Building Cost App"
        Description="TAJ Building Cost App"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.svg"
        Square44x44Logo="Assets\Square44x44Logo.svg">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.svg" Square71x71Logo="Assets\Square44x44Logo.svg" />
        <uap:SplashScreen Image="Assets\Wide310x150Logo.svg" />
      </uap:VisualElements>
    </Application>
  </Applications>
</Package>
